<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Router 所在的 herdr session（用户级 LaunchAgent）：常驻 herdr 的 router session（headless server）。
     占位符由 SKILL.md「常驻」一节的 sed 命令替换：__HERDR__ herdr 绝对路径；__HOME__ 家目录。
     Router agent 本身由问题收件箱服务按需拉起（router ensure），这里只保证 session 在。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.herdr-router</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HERDR__</string>
    <string>--session</string>
    <string>router</string>
    <string>server</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>WorkingDirectory</key>
  <string>__HOME__/workspaces</string>
  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/question-inbox/herdr-router.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/question-inbox/herdr-router.err.log</string>
</dict>
</plist>
